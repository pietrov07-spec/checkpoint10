# Copia este archivo como .env y llena lo que necesites.

# URL pública donde publicarás la app (sin barra final). Necesaria para que
# las vistas previas al compartir en redes (Open Graph) usen URLs absolutas.
VITE_SITE_URL=https://checkpoint10.vercel.app

# Clave gratuita de RAWG (https://rawg.io/apidocs). Activa el buscador que llena
# las fichas nuevas y el script `npm run stores`. Sin clave, todo lo demás funciona.
VITE_RAWG_KEY=

# Opcional: URL de la página del mapa (el prototipo enlazaba a MapaMundial.html).
VITE_MAP_URL=
